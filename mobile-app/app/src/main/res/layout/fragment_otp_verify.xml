<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/background"
    android:padding="24dp"
    tools:context=".ui.auth.OtpVerifyFragment">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/white"
        app:strokeColor="@color/outline_variant"
        app:strokeWidth="1dp"
        app:cardPreventCornerOverlap="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp"
            >
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                android:background="@drawable/bg_circle_surface"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardShield"
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnBack"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="@color/primary_fixed"
                app:cardCornerRadius="60dp"
                app:strokeWidth="0dp"
                app:cardElevation="8dp"
                >
                <ImageView
                    android:id="@+id/ivShield"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/img_security_shield"
                    android:scaleType="centerCrop"
                    android:layout_gravity="center"
                    />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verify Your Account"
                android:textColor="@color/on_primary_fixed"
                app:layout_constraintTop_toBottomOf="@id/cardShield"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="24dp"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:fontFamily="@font/playfair_display_semibold"
                android:textFontWeight="700"
                />
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="We sent a 4-digit verification code to your email. Please enter it below."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/on_surface_variant"
                android:textAlignment="center"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.chaos.view.PinView
                android:id="@+id/pinViewOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:itemCount="4"
                app:itemWidth="56dp"
                app:itemHeight="64dp"
                app:itemSpacing="16dp"
                app:itemRadius="8dp"
                app:lineColor="@color/outline_variant"
                app:lineWidth="1.5dp"
                android:cursorVisible="true"
                android:textColor="@color/on_surface"
                android:textSize="24sp"
                android:inputType="number"
                app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/pinViewOtp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvDidntReceive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Didn't receive the code? "
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/primary"
                    />

                <TextView
                    android:id="@+id/tvResend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resend in 00:30"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/text_disabled"
                    />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerify"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="Verify Code"
                app:cornerRadius="28dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:backgroundTint="@color/primary"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
