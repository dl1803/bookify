<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp">

    <!-- Avatar gradient ring -->
    <View
        android:id="@+id/vAvatarRing"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_avatar_ring_online"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Avatar inner background (white gap) -->
    <View
        android:id="@+id/vAvatarGap"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_avatar_inner_gap"
        app:layout_constraintTop_toTopOf="@id/vAvatarRing"
        app:layout_constraintBottom_toBottomOf="@id/vAvatarRing"
        app:layout_constraintStart_toStartOf="@id/vAvatarRing"
        app:layout_constraintEnd_toEndOf="@id/vAvatarRing" />

    <!-- Avatar Image -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAvatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
        app:layout_constraintTop_toTopOf="@id/vAvatarRing"
        app:layout_constraintBottom_toBottomOf="@id/vAvatarRing"
        app:layout_constraintStart_toStartOf="@id/vAvatarRing"
        app:layout_constraintEnd_toEndOf="@id/vAvatarRing"
        tools:src="@tools:sample/avatars" />

    <!-- Online Status Dot -->
    <View
        android:id="@+id/vOnlineDot"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:background="@drawable/bg_online_dot"
        app:layout_constraintBottom_toBottomOf="@id/vAvatarRing"
        app:layout_constraintEnd_toEndOf="@id/vAvatarRing"
        android:layout_marginBottom="2dp"
        android:layout_marginEnd="2dp" />

    <!-- Friend Name -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/on_surface"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/vAvatarRing"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Emma" />

</androidx.constraintlayout.widget.ConstraintLayout>
